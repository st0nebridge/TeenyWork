# Replace both values with independently generated random secrets, for example
#   python -c "import secrets; print(secrets.token_hex(32))"
# The server refuses to start with these placeholders or with an empty C2A_API_KEY.
C2A_SERVER_SECRET=replace-with-an-independent-random-secret
C2A_API_KEY=replace-with-a-separate-random-token
# Optional: size in bytes at which each ledger file rotates (default 16 MiB = 16777216).
# The live file plus 3 rotated files (.1-.3) are kept per ledger.
# C2A_LEDGER_MAX_BYTES=16777216
